# Salin file ini menjadi ".env" lalu sesuaikan.
PORT=3000

# Database MySQL (default XAMPP: user root, tanpa password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_healthy

# Kunci rahasia untuk tanda login. Ganti dengan teks acak yang panjang!
JWT_SECRET=ganti-dengan-teks-acak-panjang
